# Contact form delivery (both required for the form to send; until they are
# set the /api/contact endpoint answers 503 and the UI points visitors to
# GitHub/LinkedIn instead).
# Create a key at https://resend.com → API Keys.
RESEND_API_KEY=
# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=
# Optional sender; defaults to onboarding@resend.dev (works without a
# verified domain). Set to an address on a domain verified in Resend.
RESEND_FROM_EMAIL=

# Optional: GitHub fine-grained token, read-only. With access to the
# project repos (Contents, Pull requests, Metadata) it keeps the project
# cards' commit and PR counts live (lib/live/contributions.ts); it also
# fetches the contribution chart from the GraphQL API. Without it, both use
# their committed snapshots. Product numbers (tools, airdrops, pages) need
# no token: they come from each project's public files.
GITHUB_TOKEN=
# Optional: a token per extra repo owner (a fine-grained token covers one
# owner), named GITHUB_TOKEN_<OWNER>, e.g. GITHUB_TOKEN_ACME_LABS.

# Optional: canonical site origin, e.g. https://meelismikiver.com.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL on Vercel.
NEXT_PUBLIC_SITE_URL=
